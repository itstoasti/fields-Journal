{
  "expo": {
    "name": "Fields",
    "slug": "field-notes",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fieldnotes",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EFE6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.fields.journal",
      "infoPlist": {
        "NSCameraUsageDescription": "Fields accesses your camera to capture travel scenes for your carved stamp field notes.",
        "NSPhotoLibraryUsageDescription": "Fields accesses your photo gallery to select travel photos and read capture dates and locations.",
        "NSPhotoLibraryAddUsageDescription": "Fields saves your completed travel field note posters to your photo gallery.",
        "NSLocationWhenInUseUsageDescription": "Fields uses location metadata to identify travel destinations from your photos."
      }
    },
    "android": {
      "package": "app.fields.journal",
      "versionCode": 13,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4EFE6"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Field Notes accesses your camera to capture scenes for your travel field note stamps.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Field Notes saves your generated travel field note posters to your photo gallery.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Field Notes uses location data to identify travel destinations from your photos."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8951955f-6be0-4375-a354-015fc8a60538"
      }
    },
    "owner": "deanfieldz"
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-5918407268001346~1304879705",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511"
  }
}
